{
  "name": "resurrection-tech-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Resurrection Tech™ — Runtime Governance for Autonomous Systems. Production enterprise platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "runtime:server": "node scripts/runtime/server.cjs",
    "runtime:report": "node scripts/runtime/report.cjs",
    "runtime:test": "node scripts/runtime/gateway.test.cjs",
    "runtime:harden": "node scripts/runtime/hardening.test.cjs",
    "runtime:isolation": "node scripts/runtime/manifest-isolation.test.cjs",
    "audit": "node scripts/delivery-kit.cjs",
    "audit:check": "node scripts/delivery-kit.cjs --check",
    "audit:auth": "node scripts/delivery-kit.cjs --auth-verify",
    "audit:chrome": "node scripts/delivery-kit.cjs --check-chrome",
    "audit:chrome:install": "bash scripts/install-chromium.sh",
    "audit:selftest": "node scripts/delivery-kit.cjs --selftest",
    "audit:setup": "bash scripts/setup-delivery.sh",
    "smoke:enterprise": "node scripts/smoke-tests/enterprise-regression.cjs --report",
    "smoke:sectors": "node scripts/smoke-tests/sector-detection.test.cjs",
    "smoke:adversarial": "node scripts/smoke-tests/overlap-adversarial.test.cjs",
    "smoke:stress": "node --expose-gc scripts/smoke-tests/stress-test.cjs",
    "smoke:baseline": "node scripts/smoke-tests/enterprise-regression.cjs --update-baseline",
    "smoke:mutation": "node scripts/smoke-tests/mutation-test.cjs",
    "smoke:ci": "node scripts/smoke-tests/sector-detection.test.cjs && node scripts/smoke-tests/overlap-adversarial.test.cjs && node scripts/smoke-tests/enterprise-regression.cjs --report",
    "console": "node console/server.cjs",
    "runtime:enterprise": "node scripts/runtime/enterprise.test.cjs",
    "runtime:preflight": "node scripts/runtime/preflight.cjs",
    "runtime:set-mode": "node scripts/runtime/set-mode.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.47.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "framer-motion": "^11.18.0",
    "next": "^16.2.6",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^4.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}

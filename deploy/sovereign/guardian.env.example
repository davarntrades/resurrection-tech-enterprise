# Guardian OS Sovereign — deployment configuration.
# Copy to `.env` beside docker-compose.yml and fill in. Nothing here reaches a
# cloud service; these are local secrets for the deployment itself.

GUARDIAN_VERSION=sovereign
GUARDIAN_PROFILE=air_gapped

# Shared secret between the platform and the engine (generate on the estate):
#   openssl rand -hex 32
GOVERNANCE_TOKEN=

# Operator admin key for the Control Room (generate on the estate):
#   openssl rand -hex 32
ADMIN_KEY=

# Bind the interface to loopback by default. Change deliberately, and put it
# behind the estate's own reverse proxy + identity provider before exposing it:
# Guardian OS has no IdP of its own (see docs/ACCREDITATION.md, IA-2).
BIND_ADDR=127.0.0.1
PORT=3000

LOG_LEVEL=INFO
